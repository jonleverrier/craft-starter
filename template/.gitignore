.DS_Store
/.idea
node_modules

# Craft (Laravel keeps its own .gitignore in each storage/ and bootstrap/cache/ folder)
/craft/vendor
/craft/.env
/craft/storage/*.key

# Built and generated — Vite and Craft rebuild these
/public/dist/*
/public/cpresources/*
!/public/cpresources/.gitkeep
/public/hot
/public/storage
/public/vendor/craft
/build/scss/templates/_sprite.scss

# Uploaded assets are content, not code
/public/assets

# Local DB backups (tools/sync)
/.backups

# DDEV — machine-specific
/.ddev/.env.web
/.ddev/traefik/

# Claude worktrees
/.claude/worktrees/
