# https://craftcms.com/docs/5.x/configure.html
# tools/setup.sh copies this to .env and fills in the two blank keys.

CRAFT_APP_ID=
CRAFT_SECURITY_KEY=
CRAFT_ENVIRONMENT=dev
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# DDEV's database
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=db
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=db
CRAFT_DB_USER=db
CRAFT_DB_PASSWORD=db
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=

# Site
PRIMARY_SITE_NAME="{{ site_name | replace("\\", "\\\\") | replace('"', '\\"') | replace("${", "\\${") }}"
PRIMARY_SITE_URL=https://{{ domain }}
PRIMARY_SITE_WEBROOT=/var/www/html/public
PRIMARY_SITE_FILESYSTEM_URL=https://{{ domain }}/assets
PRIMARY_SITE_FILESYSTEM_WEBROOT=/var/www/html/public/assets
URL_SITE_PUBLIC=https://{{ domain }}

# tools/sync — the production server (leave blank until there is one)
PRODUCTION_SSH_USER=
PRODUCTION_SSH_HOST=
PRODUCTION_SSH_PATH=
