# https://craftcms.com/docs/6.x/configure.html
# tools/setup.sh copies this to .env and fills in the two blank keys.

APP_NAME="{{ site_name | replace("\\", "\\\\") | replace('"', '\\"') | replace("${", "\\${") }}"
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=https://{{ domain }}

CRAFT_APP_ID=
CRAFT_ENVIRONMENT=dev
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# DDEV's database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db
DB_PREFIX=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Mail: DDEV's Mailpit locally (https://{{ domain }}:8026).
# Production: MAIL_MAILER=postmark and POSTMARK_API_KEY=...
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="{{ admin_email | replace("\\", "\\\\") | replace('"', '\\"') | replace("${", "\\${") }}"
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_API_KEY=

# Site
PRIMARY_SITE_NAME="{{ site_name | replace("\\", "\\\\") | replace('"', '\\"') | replace("${", "\\${") }}"
PRIMARY_SITE_URL=https://{{ domain }}
PRIMARY_SITE_WEBROOT=/var/www/html/public
PRIMARY_SITE_FILESYSTEM_URL=https://{{ domain }}/assets
PRIMARY_SITE_FILESYSTEM_WEBROOT=/var/www/html/public/assets
URL_SITE_PUBLIC=https://{{ domain }}

# tools/sync — the production server (leave blank until there is one)
PRODUCTION_SSH_USER=
PRODUCTION_SSH_HOST=
PRODUCTION_SSH_PATH=
