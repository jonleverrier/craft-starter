{#
  Every error page. Craft 6 looks for errors/<status code>, then errors/error, which
  includes this view.
#}
{% extends '_layouts/page.twig' %}

{% set tplPath = _self %}

{% set titles = {
    404: 'Page not found',
    503: 'Back soon',
} %}
{% set title = titles[statusCode] ?? 'Something went wrong' %}
{% set pageTitleParts = [title] %}

{% block siteContent %}
    <h1>{{ title }}</h1>
    <p><a href="{{ siteUrl }}">Back to the home page</a></p>
{% endblock %}
